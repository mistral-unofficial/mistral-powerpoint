{
  "name": "mistral-ppt",
  "version": "1.0.0",
  "private": true,
  "description": "PowerPoint add-in powered by the Mistral AI API",
  "type": "module",
  "config": {
    "app_to_debug": "powerpoint",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "certs": "office-addin-dev-certs install",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "manifest:prod": "node scripts/make-prod-manifest.mjs",
    "validate:prod": "office-addin-manifest validate manifest.prod.xml"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.617",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
